# Copy the values you need into your MCP client's server configuration ("env" block).
# Only the first two are required for the standard product tools.

TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=

# basic (default) or digest
# TELESIGN_AUTH_METHOD=basic

# Toolsets listed at startup: core (default) | extended | all | comma-separated keys and groups,
# e.g. core,voice,messaging or extended,accounts
# TELESIGN_TOOLSETS=core

# Set to false to stop the assistant switching on toolsets that are not listed above
# TELESIGN_DYNAMIC_TOOLSETS=true

# Return the request each tool would send instead of sending it
# TELESIGN_DRY_RUN=true

# Register only tools that neither contact an end user nor change data
# TELESIGN_READ_ONLY=true

# TELESIGN_TIMEOUT_MS=30000
# TELESIGN_DOWNLOAD_DIR=./downloads

# Host overrides (for example during a failover)
# TELESIGN_REST_URL=https://rest-ww.telesign.com
# TELESIGN_VERIFY_URL=https://verify.telesign.com
# TELESIGN_DETECT_URL=https://detect.telesign.com

# SCIM toolset (OAuth 2.0 client credentials)
# TELESIGN_OAUTH_CLIENT_ID=
# TELESIGN_OAUTH_CLIENT_SECRET=

# protect-platform toolset
# TELESIGN_PROTECT_USERNAME=
# TELESIGN_PROTECT_PASSWORD=
# TELESIGN_PROTECT_API_KEY=
# TELESIGN_PROTECT_REGION=us-east-1
# TELESIGN_PROTECT_PRODUCT_ID=3

# Show bearer tokens in tool results instead of masking them
# TELESIGN_REVEAL_TOKENS=true
