{
  "name": "telesign-mcp",
  "version": "2.0.0",
  "description": "MCP server for Telesign APIs - verification, messaging, voice, number masking, Phone ID and fraud intelligence",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "telesign-mcp": "build/index.js"
  },
  "scripts": {
    "build": "shx rm -rf build && tsc && npm run copy-docs",
    "copy-docs": "shx mkdir -p build/docs/reference && shx cp src/docs/*.md build/docs/ && shx cp src/docs/reference/*.md build/docs/reference/",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "sync-specs": "node scripts/sync-specs.mjs",
    "test": "npm run build && node --test test/server.test.mjs test/toolsets.test.mjs test/safety.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telesign",
    "mcp",
    "model-context-protocol",
    "sms",
    "otp",
    "verification",
    "phone",
    "ai",
    "claude",
    "chatgpt",
    "llm",
    "voice",
    "whatsapp",
    "rcs",
    "fraud",
    "phone-intelligence",
    "2fa"
  ],
  "author": "Max Peaslee <mdp18@uw.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdp18/telesign-mcp.git"
  },
  "homepage": "https://github.com/mdp18/telesign-mcp#readme",
  "bugs": {
    "url": "https://github.com/mdp18/telesign-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}
